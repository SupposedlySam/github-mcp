# GitHub authentication.
# Create a token at https://github.com/settings/tokens
# Required scopes: repo, read:org. Add `workflow` if you plan to dispatch or
# cancel GitHub Actions runs.
# If unset, the server falls back to `gh auth token` (GitHub CLI).
GITHUB_TOKEN=

# Default owner/repo so tools can omit `owner` and `repo` arguments.
GITHUB_OWNER=hii-inc-sebu
GITHUB_REPO=drops

# Optional: GitHub Enterprise base URL (defaults to https://api.github.com).
# GITHUB_API_URL=

# Optional: enable destructive tools (deletePullRequestTask).
# GITHUB_ENABLE_DANGEROUS=false

# Optional logging controls (file logging is on by default, outside the repo).
# GITHUB_MCP_LOG_DISABLE=false
# GITHUB_MCP_LOG_FILE=
# GITHUB_MCP_LOG_DIR=
# GITHUB_MCP_LOG_PER_CWD=false
